kubernetes_config_path    = "~/.kube/config"
kubernetes_config_context = "replace-with-context"

app_name    = "auronix"
environment = "dev"
namespace   = "auronix"

server_image     = "jpplay/auditex-server"
server_image_tag = "replace-with-commit-sha"

server_replicas     = 1
server_service_type = "LoadBalancer"

server_load_balancer_source_ranges = ["0.0.0.0/0"]

server_env = {
  DATABASE_URL   = "jdbc:postgresql://replace-with-db-host:5432/auronix"
  REDIS_URL      = "redis://replace-with-redis-host:6379"
  CLIENT_URLS    = "https://app.example.com"
  JPA_DDL_AUTO   = "update"
  JPA_SHOW_SQL   = "false"
  JPA_FORMAT_SQL = "false"
}

server_secret_env = {
  DATABASE_USERNAME = "replace-with-database-username"
  DATABASE_PASSWORD = "replace-with-database-password"
  RABBITMQ_URL      = "amqp://replace-with-user:replace-with-password@replace-with-rabbitmq-host:5672/"
  JWT_SECRET        = "replace-with-a-long-random-secret"
}
